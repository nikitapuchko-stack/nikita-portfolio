          </main>

          <!-- RIGHT CUSTOM SCROLLBAR -->
          <div class="scroll-ui" aria-hidden="true">
            <button class="scroll-button scroll-up" type="button" aria-label="Scroll up"></button>

            <div class="scroll-dot-track">
              <button class="scroll-dot" type="button" aria-label="Scroll position"></button>
            </div>

            <button class="scroll-button scroll-down" type="button" aria-label="Scroll down"></button>
