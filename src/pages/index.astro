---
import "../styles/global.css";
import NavDotIcon from "../components/NavDotIcon.astro";

const base = (import.meta.env.BASE_URL || "/").replace(/\/?$/, "/");
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Nikita Puchko — Graphic & Brand Designer</title>

    <link rel="icon" type="image/svg+xml" href={`${base}images/favicon.svg`} />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;1,100;1,200;1,300;1,400;1,500;1,600;1,700&display=swap" rel="stylesheet">
  </head>

  <body id="top" data-base-path={base}>
    <div class="page">
      <header class="site-header">
        <nav class="nav" aria-label="Primary">
          <a class="nav-link is-active" href="#about" data-nav="about" data-sidebar-target aria-label="About">
            <NavDotIcon name="about" />
          </a>
          <a class="nav-link" href="#skills" data-nav="skills" data-sidebar-target aria-label="Skills">
            <NavDotIcon name="skills" />
          </a>
          <a class="nav-link" href="#contact" data-nav="contacts" data-sidebar-target aria-label="Contacts">
            <NavDotIcon name="contacts" />
          </a>
          <a
            class="nav-link nav-link-work work-toggle"
            data-nav="work"
            href="#work"
            data-panel-toggle="work-panel"
            aria-controls="work-panel"
            aria-expanded="false"
            aria-label="Work"
          >
            <NavDotIcon name="work" />
          </a>
        </nav>
      </header>

      <div class="content-stage">
        <div class="main-view">
          <div class="content-layout">
        <!-- LEFT COLUMN -->
        <div class="scroll-panel sidebar-panel">
          <aside class="sidebar" id="about">
            <div class="brand-block">
              <div class="brand-main">
                <a
                  class="brand"
                  href="#top"
                  aria-label="Nikita Puchko home"
                >
                  <img
                    class="logo"
                    src={`${base}images/My photo.png`}
                    alt="Nikita Puchko portrait"
                  />

                  <div class="brand-text">
                    <p class="name">Nikita Puchko</p>
                    <p class="role">Graphic &amp; Brand Designer</p>
                  </div>
                </a>
              </div>

              <div class="brand-status-row" aria-label="Work experience and availability">
                <div class="brand-status brand-experience" aria-label="Work experience since January 2022">
                  <span class="brand-status-label">WORK EXPERIENCE:</span>
                  <strong class="brand-status-value work-years">0</strong>
                  <span class="brand-status-unit">years</span>
                  <strong class="brand-status-value work-days">0</strong>
                  <span class="brand-status-unit">days</span>
                </div>

                <div class="brand-status brand-availability">
                  <span class="brand-status-label">STATUS:</span>
                  <strong class="brand-status-value">OPEN TO WORK</strong>
                </div>
              </div>
            </div>

            <section class="bio">
              <h2 class="eyebrow">Bio</h2>

              <p>
                Multidisciplinary graphic designer focused on brand identity.
                Working both independently and as a part of a team, I use my
                creativity and love for aesthetics to evolve brands.
              </p>
            </section>

            <section class="cards" aria-label="About sections">
              <article class="card">
                <h3>Design habits</h3>

                <ul>
                  <li>Comfortable taking responsibility for the whole project, respecting deadlines and keeping the design consistent and aligned with the task.</li>
                  <li>Work across different industries and visual styles, depending on the project.</li>
                  <li>I can create both clean, grid-based design and more expressive, raw visual directions.</li>
                </ul>
              </article>

              <article class="card">
                <h3>Inspiration sources</h3>

                <ul>
                  <li>Urban and nature hiking</li>
                  <li>Cooking</li>
                  <li>Crafting (hand printing, drawing &amp; painting)</li>
                  <li>My dog Dexter</li>
                </ul>
              </article>

              <article class="card">
                <h3>Values</h3>

                <ul>
                  <li>Ethical collaboration with people, teams, world</li>
                  <li>Clarity and respect in communication</li>
                  <li>Care and attention to details</li>
                </ul>
              </article>
            </section>

            <div class="what-i-do-separator" aria-hidden="true">
              <span></span>
              <span></span>
              <span></span>
              <span></span>
              <span></span>
              <span></span>
              <span></span>
              <span></span>
              <span></span>
              <span></span>
              <span></span>
              <span></span>
              <span></span>
              <span></span>
              <span></span>
              <span></span>
              <span></span>
              <span></span>
              <span></span>
              <span></span>
              <span></span>
              <span></span>
              <span></span>
              <span></span>
              <span></span>
            </div>

            <section class="what-i-do" id="skills" aria-label="What I do">
              <h2 class="what-i-do-title">What I do</h2>

              <article class="service-item">
                <img class="service-media" src={`${base}images/Car spin.gif`} alt="3D visualization animation" />
                <div class="service-caption">3D Visualization</div>
              </article>

              <article class="service-item">
                <img class="service-media" src={`${base}images/Posters.png`} alt="Poster design" />
                <div class="service-caption">2D Graphic</div>
              </article>

              <article class="service-item">
                <img class="service-media" src={`${base}images/Snake.gif`} alt="Snake motion graphic" />
                <div class="service-caption">Motion</div>
              </article>

              <div class="service-tags" aria-label="Service list">
                <span>Brand identity &amp; visual systems</span>
                <span class="dot" aria-hidden="true"></span>
                <span>Logo design</span>
                <span>Key visuals &amp; campaign design</span>
                <span class="dot" aria-hidden="true"></span>
                <span>Print &amp; production design</span>
                <span>Editorial design</span>
                <span class="dot" aria-hidden="true"></span>
                <span>Web &amp; landing page design</span>
                <span>3D design &amp; visualization</span>
                <span class="dot" aria-hidden="true"></span>
                <span>Spatial &amp; experiential design</span>
                <span>Creative direction &amp; art direction</span>
                <span class="dot" aria-hidden="true"></span>
              </div>
            </section>

            <section class="skills" aria-label="Skill set">
              <h2 class="skills-title">SKILL SET</h2>

              <div class="skill" style="--delay: 0ms; --skill-level: 100%;">
                <div class="skill-label">Adobe Illustrator</div>
                <div class="skill-bar" aria-hidden="true">
                  <span class="skill-progress"></span>
                  <span class="skill-dot"></span>
                </div>
              </div>

              <div class="skill" style="--delay: 80ms; --skill-level: 100%;">
                <div class="skill-label">Adobe Photoshop</div>
                <div class="skill-bar" aria-hidden="true">
                  <span class="skill-progress"></span>
                  <span class="skill-dot"></span>
                </div>
              </div>

              <div class="skill" style="--delay: 160ms; --skill-level: 93%;">
                <div class="skill-label">Figma</div>
                <div class="skill-bar" aria-hidden="true">
                  <span class="skill-progress"></span>
                  <span class="skill-dot"></span>
                </div>
              </div>

              <div class="skill" style="--delay: 240ms; --skill-level: 93%;">
                <div class="skill-label">Blender 3D</div>
                <div class="skill-bar" aria-hidden="true">
                  <span class="skill-progress"></span>
                  <span class="skill-dot"></span>
                </div>
              </div>

              <div class="skill" style="--delay: 320ms; --skill-level: 42%;">
                <div class="skill-label">Cavalry</div>
                <div class="skill-bar" aria-hidden="true">
                  <span class="skill-progress"></span>
                  <span class="skill-dot"></span>
                </div>
              </div>

              <div class="skill" style="--delay: 400ms; --skill-level: 76%;">
                <div class="skill-label">AI tools (GPT, Mj, NB)</div>
                <div class="skill-bar" aria-hidden="true">
                  <span class="skill-progress"></span>
                  <span class="skill-dot"></span>
                </div>
              </div>

              <div class="skill" style="--delay: 480ms; --skill-level: 42%;">
                <div class="skill-label">Vibecoding</div>
                <div class="skill-bar" aria-hidden="true">
                  <span class="skill-progress"></span>
                  <span class="skill-dot"></span>
                </div>
              </div>
            </section>

            <div class="what-i-do-separator bottom-separator" aria-hidden="true">
              <span></span>
              <span></span>
              <span></span>
              <span></span>
              <span></span>
              <span></span>
              <span></span>
              <span></span>
              <span></span>
              <span></span>
              <span></span>
              <span></span>
              <span></span>
              <span></span>
              <span></span>
              <span></span>
              <span></span>
              <span></span>
              <span></span>
              <span></span>
              <span></span>
              <span></span>
              <span></span>
              <span></span>
              <span></span>
            </div>

            <footer class="footer" id="contact" aria-labelledby="footer-title">
              <div class="footer-basement">
                <img src={`${base}images/icons/Basement_bar.svg`} width="867" height="214" alt="" />
              </div>

              <div class="footer-main">
                <h2 class="footer-title" id="footer-title">CONTACTS</h2>

                <div class="footer-contacts">
                  <a class="footer-contact-row" href="https://www.instagram.com/nikita_makes_dsgn/" target="_blank" rel="noopener noreferrer">
                    <img class="footer-contact-icon" src={`${base}images/icons/instagram_icon.svg`} alt="" />
                    <span>@nikita_makes_dsgn</span>
                  </a>
                  <a class="footer-contact-row" href="https://www.behance.net/NikitaPuchko" target="_blank" rel="noopener noreferrer">
                    <img class="footer-contact-icon" src={`${base}images/icons/behance_icon.svg`} alt="" />
                    <span>www.behance.net/NikitaPuchko</span>
                  </a>
                  <a class="footer-contact-row" href="https://t.me/NikitaPuchko" target="_blank" rel="noopener noreferrer">
                    <img class="footer-contact-icon" src={`${base}images/icons/telegram_icon.svg`} alt="" />
                    <span>@NikitaPuchko</span>
                  </a>
                  <a class="footer-contact-row" href="https://www.linkedin.com/in/nikita-puchko/" target="_blank" rel="noopener noreferrer">
                    <img class="footer-contact-icon" src={`${base}images/icons/linkedin_icon.svg`} alt="" />
                    <span>https://www.linkedin.com/in/nikita-puchko/</span>
                  </a>
                  <a class="footer-contact-row" href="mailto:nikitapuchko@gmail.com">
                    <img class="footer-contact-icon" src={`${base}images/icons/mail_icon.svg`} alt="" />
                    <span>nikitapuchko@gmail.com</span>
                  </a>
                </div>

                <div class="footer-divider" aria-hidden="true"></div>

                <div class="footer-downloads">
                  <p class="footer-download-description">
                    You can download compact PDF<br />
                    with my Portfolio or Resume:
                  </p>
                  <a class="footer-download-button" href={`${base}files/Nikita Puchko Portfolio.pdf`} download="Nikita Puchko Portfolio.pdf">
                    <span class="footer-download-button-label">DOWNLOAD<br />PORTFOLIO</span>
                    <span class="footer-download-button-icon" aria-hidden="true" style={`--pdf-icon-url: url("${base}images/icons/PDF_file_icon.svg")`}></span>
                  </a>
                  <a class="footer-download-button" href={`${base}files/Nikita Puchko CV.pdf`} download="Nikita Puchko CV.pdf">
                    <span class="footer-download-button-label">DOWNLOAD<br />RESUME</span>
                    <span class="footer-download-button-icon" aria-hidden="true" style={`--pdf-icon-url: url("${base}images/icons/PDF_file_icon.svg")`}></span>
                  </a>
                </div>

                <div class="footer-divider footer-divider-bottom" aria-hidden="true"></div>

                <div class="footer-bottom">
                  <p class="footer-signature">
                    <strong>Nikita Puchko</strong><span> • Graphic &amp; Brand Designer</span>
                  </p>
                  <p class="footer-cta">feel free to contact me</p>
                </div>
              </div>
            </footer>
          </aside>

          <!-- LEFT CUSTOM SCROLLBAR -->
          <div class="scroll-ui" aria-hidden="true">
            <button class="scroll-button scroll-up" type="button" aria-label="Scroll up"></button>

            <div class="scroll-dot-track">
              <button class="scroll-dot" type="button" aria-label="Scroll position"></button>
            </div>

            <button class="scroll-button scroll-down" type="button" aria-label="Scroll down"></button>
          </div>
        </div>

        <!-- RIGHT COLUMN -->
        <div class="scroll-panel work-panel" id="work-panel" aria-label="Work panel">
          <main class="carousel" id="work">
            <article class="slide" data-project="cogs" tabindex="0">
              <img src={`${base}images/cogs.png`} alt="COGS Cycling Community brand identity" />

              <div class="project-hover-info">
                <h2>COGS Cycling Community</h2>
                <p>Brand identity</p>
              </div>
            </article>

            <article class="slide" data-project="kenya" tabindex="0">
              <img src={`${base}images/kenya-coffee.png`} alt="COIL Coffee packaging" />

              <div class="project-hover-info">
                <h2>COIL Coffee</h2>
                <p>Packaging design</p>
              </div>
            </article>

            <article class="slide" data-project="beincrypto" tabindex="0">
              <img src={`${base}images/beincrypto.png`} alt="BeInCrypto Awards 2026 outdoor campaign" />

              <div class="project-hover-info">
                <h2>BeInCrypto Awards 2026</h2>
                <p>Campaign identity</p>
              </div>
            </article>

            <article class="slide" data-project="heineken" tabindex="0">
              <img src={`${base}images/heineken.png`} alt="Heineken Formula 1 influencer kit" />

              <div class="project-hover-info">
                <h2>Heineken × Formula 1</h2>
                <p>Experiential kit</p>
              </div>
            </article>

            <article class="slide" data-project="moretti" tabindex="0">
              <img src={`${base}images/moretti.png`} alt="Birra Moretti chalice packaging" />

              <div class="project-hover-info">
                <h2>Birra Moretti Chalice</h2>
                <p>Packaging design</p>
              </div>
            </article>
          </main>

          <!-- RIGHT CUSTOM SCROLLBAR -->
          <div class="scroll-ui" aria-hidden="true">
            <button class="scroll-button scroll-up" type="button" aria-label="Scroll up"></button>

            <div class="scroll-dot-track">
              <button class="scroll-dot" type="button" aria-label="Scroll position"></button>
            </div>

            <button class="scroll-button scroll-down" type="button" aria-label="Scroll down"></button>
          </div>
        </div>
          </div>
        </div>

        <div class="project-detail-view" aria-live="polite">
          <div class="project-detail-scroller">
            <div class="project-detail-content"></div>
          </div>
        </div>
      </div>
    </div>

    <script is:inline src={`${base}script.js`}></script>
  </body>
</html>
