---
import "../styles/global.css";
import NavDotIcon from "../components/NavDotIcon.astro";
import IntroView from "../components/IntroView.astro";
import { getImage } from "astro:assets";
import cogsCover from "../../public/images/cogs.png";
import coilCover from "../../public/images/kenya-coffee.png";
import beincryptoCover from "../../public/images/beincrypto.png";
import heinekenCover from "../../public/images/heineken.png";
import morettiCover from "../../public/images/moretti.png";
import backToListSource from "../../public/images/Header buttons/BackToList_button.svg?raw";

// Inline the local asset like the other header icons; no runtime asset URL.
const backToListSvg = backToListSource.replaceAll('fill="#008CFF"', 'fill="currentColor"');

const base = (import.meta.env.BASE_URL || "/").replace(/\/?$/, "/");
const carouselSizes = "(max-width: 960px) calc(100vw - 24px), calc(62vw - 45px)";
// Shared by carousel copies and project heroes; Astro emits hashed assets.
const projectCovers = Object.fromEntries(await Promise.all(
  Object.entries({ cogs: cogsCover, kenya: coilCover, beincrypto: beincryptoCover, heineken: heinekenCover, moretti: morettiCover })
    .map(async ([id, source]) => {
      const widths = [640, 960, 1440, source.width];
      const variants = await Promise.all(widths.map(width => getImage({ src: source, width, format: "webp", quality: 85 })));
      return [id, {
        src: variants[1].src,
        srcset: variants.map((image, index) => `${image.src} ${widths[index]}w`).join(", "),
        width: source.width,
        height: source.height,
      }];
    })
));
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />

    <title>Nikita Puchko — Graphic & Brand Designer</title>

