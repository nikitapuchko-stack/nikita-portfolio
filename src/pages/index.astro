            <span aria-hidden="true" set:html={backToListSvg} />
          </button>
        </nav>
      </header>

      <div class="content-stage">
        <div class="main-view">
          <div class="content-layout">
        <!-- LEFT COLUMN -->
        <div class="scroll-panel sidebar-panel">
          <aside class="sidebar" id="about">
            <div class="brand-block">
              <p class="name">Nikita<br />Puchko</p>
              <div class="brand-experience" aria-label="Work experience since January 2022">
                <span class="brand-status-label">EXPERIENCE:</span>
                <p><span class="work-years">0</span><small> y </small><span class="work-days">0</span><small> d</small></p>
                <p><span class="work-hours">00</span> : <span class="work-minutes">00</span><small> h:m</small></p>
