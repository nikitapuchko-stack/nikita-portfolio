---
import { readdir } from "node:fs/promises";
import sharp from "sharp";
import { resolve, join } from "node:path";
import IntroDots from "./IntroDots.astro";

const base = (import.meta.env.BASE_URL || "/").replace(/\/?$/, "/");
const directory = resolve("public/images/Loading_page_assets/Teaser_images");
const filenames = (await readdir(directory))
  .filter(name => /\.(jpe?g|png|webp|avif|gif)$/i.test(name))
  .sort((a, b) => a.localeCompare(b, "en", { numeric: true }));
const images = await Promise.all(filenames.map(async (name, index) => {
  const { width, height } = await sharp(join(directory, name)).metadata();
  return { src: `${base}images/Loading_page_assets/Teaser_images/${encodeURIComponent(name)}`, width, height, alt: `Selected work preview ${index + 1}` };
}));
// Start with the COIL packaging shown in the reference; keep the full numeric sequence.
const initialIndex = Math.max(0, filenames.indexOf("10.jpg"));
const slots = [-3, -2, -1, 0, 1, 2, 3];
---

<section class="intro-view" role="dialog" aria-modal="true" aria-label="Nikita Puchko portfolio introduction" tabindex="-1" data-active-index={initialIndex}>
  <span class="intro-dot intro-dot-top-left" aria-hidden="true"></span>
  <span class="intro-dot intro-dot-top-right" aria-hidden="true"></span>
  <span class="intro-dot intro-dot-bottom-left" aria-hidden="true"></span>
  <span class="intro-dot intro-dot-bottom-right" aria-hidden="true"></span>
  <IntroDots />
  <div class="intro-carousel" role="region" aria-label="Selected work previews. Scroll or swipe vertically; use arrow keys to browse.">
    {images.length > 0 && slots.map(slot => {
      const image = images[(initialIndex + slot + images.length) % images.length];
      return <img class="intro-card" {...image} data-slot={slot} aria-current={slot === 0 ? "true" : undefined} aria-hidden={slot !== 0 ? "true" : undefined} loading="eager" decoding="async" fetchpriority={slot === 0 ? "high" : "auto"} draggable="false" />;
    })}
  </div>
  <div class="intro-identity">
    <p class="intro-name">Nikita Puchko</p>
    <p class="intro-role">Graphic &amp; Brand Designer</p>
    <button class="intro-enter" type="button" aria-label="Go to portfolio">GO TO PORTFOLIO</button>
  </div>
  <script is:inline type="application/json" id="intro-images" set:html={JSON.stringify(images).replaceAll("<", "\\u003c")} />
</section>

<script>
  import { initIntroView } from "../scripts/intro";
  initIntroView();
</script>

<style>
  .intro-view {
    --intro-bg: #ececec;
    --intro-fg: var(--blue);
    --intro-card-width: min(45vw, 61dvh);
    --intro-dot-size: clamp(12px, 1.25vw, 25px);
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100dvh;
    z-index: 1000;
    overflow: hidden;
    background-color: var(--intro-bg);
    color: var(--intro-fg);
    overscroll-behavior: none;
    touch-action: pinch-zoom;
    outline: none;
    transition: transform 500ms cubic-bezier(0.76, 0, 0.24, 1), background-color 450ms ease, color 450ms ease;
  }
  .intro-view.is-closing { transform: translateX(-100%); }
  .intro-view[hidden] { display: none; visibility: hidden; pointer-events: none; }
  .intro-dot {
    position: absolute;
    width: var(--intro-dot-size);
    height: var(--intro-dot-size);
    border-radius: 50%;
    background: var(--intro-fg);
    transition: background-color 450ms ease;
    transform: translate(-50%, -50%);
  }
  .intro-dot-top-left, .intro-dot-bottom-left { left: 18.6%; }
  .intro-dot-top-right, .intro-dot-bottom-right { left: 81.4%; }
  .intro-dot-top-left, .intro-dot-top-right { top: 21.8%; }
  .intro-dot-bottom-left, .intro-dot-bottom-right { top: 81.4%; }
  .intro-carousel { position: absolute; inset: 29% 0 29%; touch-action: pinch-zoom; }
  .intro-card {
    position: absolute;
    top: 50%;
    left: 50%;
    width: var(--intro-card-width);
    max-width: none;
    height: auto;
    /* Teaser JPGs contain baked-in edge strokes; hide them without resizing the stack. */
    clip-path: inset(0.65%);
    transform-origin: center;
    transform: translate(-50%, -50%) translateX(var(--intro-x, 0%)) scale(var(--intro-scale, 1));
    /* Free scroll and snap both render their exact float position in JavaScript. */
    transition: none;
    pointer-events: none;
    user-select: none;
    z-index: 30;
  }
  .intro-card[data-slot="-1"] { --intro-x: -21%; --intro-scale: 0.8; z-index: 20; }
  .intro-card[data-slot="1"] { --intro-x: 21%; --intro-scale: 0.8; z-index: 20; }
  .intro-card[data-slot="-2"] { --intro-x: -42%; --intro-scale: 0.6; z-index: 10; }
  .intro-card[data-slot="2"] { --intro-x: 42%; --intro-scale: 0.6; z-index: 10; }
  .intro-card[data-slot="-3"] { --intro-x: -55%; --intro-scale: 0; opacity: 0; z-index: 0; }
  .intro-card[data-slot="3"] { --intro-x: 55%; --intro-scale: 0; opacity: 0; z-index: 0; }
  .intro-identity {
    position: absolute;
    top: 76.8%;
    left: 50%;
    width: max-content;
    max-width: calc(100% - 32px);
    transform: translateX(-50%);
    text-align: center;
    font-size: clamp(12px, 0.95vw, 20px);
    line-height: 1.65;
  }
  .intro-enter {
    display: block;
    margin: 10px auto 0;
    padding: 2px 10px;
    border: 0;
    border-radius: 0;
    background: var(--intro-fg);
    color: var(--intro-bg);
    transition: background-color 450ms ease, color 450ms ease, outline-color 450ms ease;
    font-family: inherit;
    font-size: clamp(18px, 1.3vw, 28px);
    font-weight: 700;
    line-height: 1.2;
    cursor: pointer;
  }
  .intro-enter:hover { background: var(--intro-bg); color: var(--intro-fg); outline: 1px solid var(--intro-fg); }
  .intro-enter:focus-visible { outline: 2px solid var(--intro-fg); outline-offset: 5px; }
  @media (max-width: 960px) {
    .intro-view { --intro-card-width: min(72vw, 61dvh); }
    .intro-dot-top-left, .intro-dot-bottom-left { left: 8%; }
    .intro-dot-top-right, .intro-dot-bottom-right { left: 92%; }
    .intro-identity { font-size: 14px; }
    .intro-enter { min-height: 44px; font-size: 20px; }
  }
  @media (max-height: 500px) {
    .intro-dot-top-left, .intro-dot-top-right { top: 12%; }
    .intro-carousel { inset: 20% 0 34%; }
    .intro-view { --intro-card-width: min(45vw, 58dvh); }
    .intro-identity { top: 72%; font-size: 12px; line-height: 1.4; }
    .intro-enter { margin-top: 4px; min-height: 32px; font-size: 16px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .intro-view, .intro-card, .intro-dot, .intro-enter { transition: none; }
  }
</style>
